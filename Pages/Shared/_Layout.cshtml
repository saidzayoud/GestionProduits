<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GestionProduits</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GestionProduits.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg site-navbar mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">GestionProduits</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Produits/Index">Produits</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Categories/Index">Catégories</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - GestionProduits - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Highlight active nav link based on current path
        (function(){
            var links = document.querySelectorAll('.site-navbar .nav-link, .navbar .nav-link');
            var path = location.pathname.toLowerCase();
            links.forEach(function(a){
                try{
                    var href = a.getAttribute('href') || a.getAttribute('data-href') || a.getAttribute('asp-page');
                    if(!href) href = a.href;
                    if(href){
                        // Normalize
                        if(href.indexOf(location.origin) === 0) href = href.substring(location.origin.length);
                        if(path === href || path === href.replace(/\/$/,'')){
                            a.classList.add('active');
                        }
                    }
                }catch(e){}
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>